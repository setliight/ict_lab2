      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\n",
        "data = [\n",
        "    [1, \"2026-01-15\", \"Item_A1\", \"A\", \"Almaty\", 150.5, 140],\n",
        "    [2, \"2026-01-18\", \"Item_B1\", \"B\", \"Astana\", 220.0, 200],\n",
        "    [3, \"2026-02-05\", \"Item_A2\", \"A\", \"Shymkent\", 95.5, 110],\n",
        "    [4, \"2026-02-12\", \"Item_C1\", \"C\", \"Almaty\", 310.0, 300],\n",
        "    [5, \"2026-03-01\", \"Item_B2\", \"B\", \"Astana\", 180.2, 190],\n",
        "    [6, \"2026-03-15\", \"Item_A3\", \"A\", \"Almaty\", 275.8, 250],\n",
        "    [7, \"2026-04-10\", \"Item_C2\", \"C\", \"Shymkent\", 140.0, 150],\n",
        "    [8, \"2026-04-22\", \"Item_B3\", \"B\", \"Almaty\", 410.5, 380],\n",
        "    [9, \"2026-05-05\", \"Item_A4\", \"A\", \"Astana\", 195.0, 200],\n",
        "    [10, \"2026-05-18\", \"Item_C3\", \"C\", \"Shymkent\", 330.0, 320],\n",
        "    [11, \"2026-06-02\", \"Item_B4\", \"B\", \"Almaty\", 250.0, 240],\n",
        "    [12, \"2026-06-20\", \"Item_A5\", \"A\", \"Astana\", 210.0, 220]\n",
        "]\n",
        "columns = [\"ID\", \"Date\", \"Item\", \"Category\", \"Region\", \"Value\", \"Plan\"]\n",
        "df = pd.DataFrame(data, columns=columns)\n",
        "\n",
        "\n",
        "pivot_agg = df.groupby('Category').agg(\n",
        "    Count=('Value', 'count'),\n",
        "    Total_Value=('Value', 'sum'),\n",
        "    Average_Value=('Value', 'mean')\n",
        ").reset_index()\n",
        "\n",
        "pivot_agg['% of Total'] = (pivot_agg['Total_Value'] / pivot_agg['Total_Value'].sum()) * 100\n",
        "print(\"--- Агрегированный результат в Pandas ---\")\n",
        "print(pivot_agg)\n",
        "\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.bar(pivot_agg['Category'], pivot_agg['Total_Value'], color=['#1f77b4', '#ff7f0e', '#2ca02c'])\n",
        "plt.title('Суммарный объем по категориям (Python / Matplotlib)', fontsize=12, fontweight='bold')\n",
        "plt.xlabel('Категория', fontsize=10)\n",
        "plt.ylabel('Общий объем (Value)', fontsize=10)\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.show()"
      ],
